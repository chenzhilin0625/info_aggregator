<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A股每日分析 - {{ report_date }}</title>
<style>
  :root {
    --primary: #1a237e;
    --primary-light: #e8eaf6;
    --accent: #ff6f00;
    --bg: #f0f2f5;
    --card: #ffffff;
    --text: #333333;
    --text-secondary: #666666;
    --text-muted: #999999;
    --border: #e8e8e8;
    --shadow: 0 2px 12px rgba(0,0,0,0.06);
    --radius: 10px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 15px; line-height: 1.8; color: var(--text); background: var(--bg);
    max-width: 780px; margin: 0 auto; padding: 24px 16px;
  }

  /* Header */
  .header {
    background: linear-gradient(135deg, #0d1b5e 0%, #1a237e 40%, #283593 100%);
    color: #fff; padding: 28px 32px; border-radius: var(--radius);
    margin-bottom: 20px; position: relative; overflow: hidden;
  }
  .header::after {
    content: ''; position: absolute; top: -50px; right: -50px;
    width: 160px; height: 160px; background: rgba(255,255,255,0.04);
    border-radius: 50%;
  }
  .header h1 { font-size: 22px; font-weight: 700; position: relative; z-index: 1; }
  .header .meta { font-size: 13px; opacity: 0.8; margin-top: 8px; position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .header .meta-item { display: flex; align-items: center; gap: 4px; }
  .header .dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,0.4); }

  /* Summary card */
  .summary-card {
    background: var(--card); border-radius: var(--radius); padding: 28px 32px;
    margin-bottom: 12px; box-shadow: var(--shadow);
  }
  .summary-card h2 {
    font-size: 17px; color: var(--primary); margin-bottom: 8px;
    padding-bottom: 10px; border-bottom: 2px solid var(--primary-light);
  }

  /* TOC */
  .toc {
    background: var(--card); border-radius: var(--radius); padding: 20px 28px;
    margin-bottom: 20px; box-shadow: var(--shadow);
  }
  .toc h3 { font-size: 14px; color: var(--primary); margin-bottom: 10px; }
  .toc-list { columns: 2; column-gap: 24px; }
  .toc-item { font-size: 13px; padding: 3px 0; break-inside: avoid; }
  .toc-item a { color: var(--text-secondary); text-decoration: none; }
  .toc-item a:hover { color: var(--primary); }

  /* Article card */
  .article-card {
    background: var(--card); border-radius: var(--radius);
    margin-bottom: 16px; box-shadow: var(--shadow); overflow: hidden;
  }
  .article-header {
    display: flex; align-items: center; gap: 14px;
    padding: 18px 24px; background: #fafbfc;
    border-bottom: 1px solid var(--border);
  }
  .article-icon {
    width: 42px; height: 42px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
  }
  .icon-article { background: #e3f2fd; }
  .icon-answer { background: #fce4ec; }
  .icon-pin { background: #fff3e0; }
  .article-info { flex: 1; min-width: 0; }
  .article-title { font-size: 15px; font-weight: 600; color: var(--text); line-height: 1.4; }
  .article-title a { color: inherit; text-decoration: none; }
  .article-title a:hover { color: var(--primary); }
  .article-meta { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
  .type-badge {
    display: inline-block; font-size: 11px; font-weight: 600;
    padding: 2px 8px; border-radius: 4px; letter-spacing: 0.3px;
  }
  .badge-article { background: #e3f2fd; color: #1565c0; }
  .badge-answer { background: #fce4ec; color: #c62828; }
  .badge-pin { background: #fff3e0; color: #e65100; }

  .article-body {
    padding: 20px 24px 24px;
    font-size: 14px; line-height: 1.9;
  }
  .article-body p { margin-bottom: 10px; }
  .article-body strong { color: #1a237e; }
  .article-body h1, .article-body h2, .article-body h3 { font-size: 15px; color: var(--primary); margin: 16px 0 6px; }
  .article-body ul, .article-body ol { padding-left: 20px; margin: 6px 0 12px; }
  .article-body li { margin: 3px 0; }
  .article-body blockquote {
    border-left: 3px solid var(--primary-light); padding: 6px 14px;
    margin: 10px 0; color: var(--text-secondary); background: #fafbfc;
    border-radius: 0 6px 6px 0;
  }

  /* Footer */
  .footer {
    text-align: center; padding: 20px; color: var(--text-muted);
    font-size: 12px; border-top: 1px solid var(--border); margin-top: 12px;
  }
</style>
</head>
<body>

<!-- Header -->
<div class="header">
  <h1>📊 A股每日分析报告</h1>
  <div class="meta">
    <span class="meta-item">📅 {{ report_date }}</span>
    <span class="dot"></span>
    <span class="meta-item">📥 抓取 {{ total_items }} 条</span>
    <span class="dot"></span>
    <span class="meta-item">✅ 相关 {{ relevant_items }} 条</span>
    <span class="dot"></span>
    <span class="meta-item">⚡ {{ elapsed_seconds }}s</span>
    <span class="dot"></span>
    <span class="meta-item">💰 ${{ api_cost }}</span>
  </div>
</div>

<!-- TOC -->
{% if sources|length > 1 %}
<div class="toc">
  <h3>📑 目录</h3>
  <div class="toc-list">
    {% for src in sources %}
    <div class="toc-item">
      <a href="#item-{{ src.num }}">
        {{ src.num }}. {{ src.title[:28] }}{% if src.title|length > 28 %}…{% endif %}
      </a>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- Content summary -->
<div class="summary-card">
  <div>{{ summary_html|safe }}</div>
</div>

<!-- Sources -->
{% if sources %}
<div class="summary-card">
  <h2>📋 原始来源</h2>
  <div style="font-size:13px;color:var(--text-secondary);line-height:2.2;">
    {% for src in sources %}
    <div style="padding:4px 0;border-bottom:1px solid #f5f5f5;">
      <span class="type-badge badge-{{ src.type }}">{{ src.type }}</span>
      <a href="{{ src.url }}" style="margin-left:6px;">{{ src.title }}</a>
      <a href="#item-{{ src.num }}" style="font-size:11px;color:#999;margin-left:4px;">📄 总结</a>
      <span style="color:var(--text-muted);margin-left:8px;">{{ src.author }} · {{ src.time }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<div class="footer">
  本报告由 AI 自动生成，仅供参考，不构成投资建议。股市有风险，投资需谨慎。
</div>
</body>
</html>
